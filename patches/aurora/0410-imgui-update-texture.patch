+
+bool update_texture(ImTextureID id, uint32_t width, uint32_t height, const uint8_t* data) noexcept {
+  for (const auto& e : g_textureEntries) {
+    if (e.id != id) {
+      continue;
+    }
+    if (e.width != width || e.height != height) {
+      return false;
+    }
+    if (!e.texture) {
+      SDL_UpdateTexture(reinterpret_cast<SDL_Texture*>(id), nullptr, data, width * 4);
+      return true;
+    }
+    const wgpu::TexelCopyTextureInfo dstView{
+        .texture = e.texture,
+    };
+    const uint32_t copyBytesPerRow = AURORA_ALIGN(width * 4, 256);
+    const wgpu::TexelCopyBufferLayout dataLayout{
+        .bytesPerRow = copyBytesPerRow,
+        .rowsPerImage = height,
+    };
+    const wgpu::Extent3D size{.width = width, .height = height, .depthOrArrayLayers = 1};
+    enqueue_texture_upload(create_texture_upload_buffer(width, height, data, copyBytesPerRow), dstView, dataLayout,
+                           size);
+    return true;
+  }
+  return false;
 }
