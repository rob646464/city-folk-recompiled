+static void audit_pipeline(const PipelineConfig& pc, GXPrimitive prim) noexcept {
+  static const bool enabled = [] {
+    const char* env = std::getenv("AURORA_GX_AUDIT");
+    return env != nullptr && env[0] == '1';
+  }();
+  if (!enabled) {
+    return;
+  }
