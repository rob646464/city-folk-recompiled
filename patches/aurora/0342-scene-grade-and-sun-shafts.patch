+  let dir = normalize(view_pos(px, 0.5));
+  var tend = maxd;
+  if (d0 > 1e-7) { tend = min(length(view_pos(px, d0)), maxd); }
+  let mb = (s * 6u + 4u) * 24u;
+  let adims = fx.xl[32].xy;
+  let jit = ign(mp);
+  var acc = 0.0;
+  for (var k = 0u; k < steps; k++) {
+    let x = dir * ((f32(k) + jit) / f32(steps) * tend);
+    let vz = -x.z;
+    var c = 0u;
