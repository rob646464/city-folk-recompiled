+// draw uses it, to see which parts of the GX pipeline a game exercises.
+static void audit_tag(std::string tag) noexcept {
+  static absl::flat_hash_set<std::string> seen;
+  if (seen.insert(tag).second) {
+    Log.info("[gx-audit] {}", tag);
+  }
