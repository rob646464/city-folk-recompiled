+  let hg = (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * cv, 1e-4), 1.5);
+  let phase = 0.25 + hg * 0.12;
+  let amount = acc / f32(steps) * (tend / maxd) * phase;
+  return vec4f(fx.beam[1].rgb * amount, 1.0);
+}
