+// (0560) Distance along the ray of march step i (+ jitter offset in steps): quadratic spacing that
+// reaches maxLen at the last step. The steps grow with the distance (finer where the reflected
+// object is near: a character standing in the water is a few steps long instead of one, so a step
+// can no longer jump over a head or an arm), and none is spent past maxLen, where the reflection has
+// faded out (the old geometric steps, maxLen / steps growing by 6 %, ended at 1.6-3.8 maxLen).
+fn ssr_t(i: f32, steps: i32, maxLen: f32) -> f32 {
+  let x = i / f32(steps);
+  return maxLen * x * x;
+}
+// (0560) How far the last ssr() hit stands above the reflecting plane: 0 at the plane (foam and
+// surf decals lying on the water, the bank's foot) .. 1 from 3 % of the distance up (a character's
+// shoes and everything above).
+var<private> g_ssrLift: f32 = 0.0;
+fn ssr_lift(hit: vec3f, p: vec3f, dist: f32) -> f32 {
+  return smoothstep(0.01 * dist, 0.03 * dist, dot(hit - p, up_view()));
+}
