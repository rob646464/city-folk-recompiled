+// 0300 GXSetAuroraPhysicalMemoryRange: host windows for guest physical addresses (size 0 = unused).
+struct PhysRange {
+  u32 start = 0;
+  u32 size = 0;
+  u8* host = nullptr;
+};
+extern PhysRange g_physRanges[4];
+inline bool phys_mapped() noexcept { return g_physRanges[0].size != 0; }
+inline void* phys_to_host(u32 addr, u32 len = 1) noexcept {
+  for (const auto& r : g_physRanges) {
+    if (r.size == 0) {
+      break;
+    }
+    if (addr - r.start < r.size && len <= r.size - (addr - r.start)) {
+      return r.host + (addr - r.start);
+    }
+  }
+  return nullptr;
+}
 // 0176: set by populate_pipeline_config: 1 = blended RGBA6 draw quantized after its pass (efb_blend6), 3 = and it dithers
 extern u8 g_drawEfbBlend6;
