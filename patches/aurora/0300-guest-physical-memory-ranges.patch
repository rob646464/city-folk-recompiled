       reader.skip(8);
+      // 0300: a call written by game code (raw FIFO or a game-built list) carries a physical
+      // address. Calls inside a called list are ignored, as the command processor does.
+      static thread_local u32 sDlDepth = 0;
+      const u8* dl = static_cast<const u8*>(phys_to_host(dlAddr & 0x3FFFFFE0, dlSize));
+      if (dl != nullptr && sDlDepth == 0 && dlSize != 0) {
